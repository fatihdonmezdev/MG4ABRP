<?xml version="1.0" encoding="utf-8"?>
<!--
    The Vehicle page: every signal this build can read from the car, in the order a
    driver glances at them.

    The rows are static views rather than a RecyclerView on purpose — the set is fixed
    and known at build time, and MainActivity holds the value TextViews the same way it
    holds every other widget on the other pages. A row whose signal the car does not
    publish shows a dash, never a zero: on this vehicle a zero from an unimplemented
    VHAL property is indistinguishable from a reading, and "0 °C" or "0 kWh" is worse
    than an honest blank.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <!-- Live vehicle data -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardBackgroundColor="@color/ev_surface"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/ev_outline"
            app:strokeWidth="1dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:text="@string/vehicle_live_data"
                    android:textAppearance="@style/Text.EV.Title" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="0">

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_row_soc" />
                        <TextView android:id="@+id/vehicle_soc" style="@style/DataValue" />
                    </TableRow>

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_row_range" />
                        <TextView android:id="@+id/vehicle_range" style="@style/DataValue" />
                    </TableRow>

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_row_power" />
                        <TextView android:id="@+id/vehicle_power" style="@style/DataValue" />
                    </TableRow>

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_row_speed" />
                        <TextView android:id="@+id/vehicle_speed" style="@style/DataValue" />
                    </TableRow>

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_row_odometer" />
                        <TextView android:id="@+id/vehicle_odometer" style="@style/DataValue" />
                    </TableRow>

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_row_charging" />
                        <TextView android:id="@+id/vehicle_charging" style="@style/DataValue" />
                    </TableRow>

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_row_batt_temp" />
                        <TextView android:id="@+id/vehicle_batt_temp" style="@style/DataValue" />
                    </TableRow>

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_row_ext_temp" />
                        <TextView android:id="@+id/vehicle_ext_temp" style="@style/DataValue" />
                    </TableRow>

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_row_cabin_temp" />
                        <TextView android:id="@+id/vehicle_cabin_temp" style="@style/DataValue" />
                    </TableRow>

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_row_hvac" />
                        <TextView android:id="@+id/vehicle_hvac" style="@style/DataValue" />
                    </TableRow>

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_row_capacity" />
                        <TextView android:id="@+id/vehicle_capacity" style="@style/DataValue" />
                    </TableRow>

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_row_soe" />
                        <TextView android:id="@+id/vehicle_soe" style="@style/DataValue" />
                    </TableRow>

                </TableLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tyre pressures -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ev_surface"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/ev_outline"
            app:strokeWidth="1dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:text="@string/vehicle_tires"
                    android:textAppearance="@style/Text.EV.Title" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="0">

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_tire_fl" />
                        <TextView android:id="@+id/vehicle_tire_fl" style="@style/DataValue" />
                    </TableRow>

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_tire_fr" />
                        <TextView android:id="@+id/vehicle_tire_fr" style="@style/DataValue" />
                    </TableRow>

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_tire_rl" />
                        <TextView android:id="@+id/vehicle_tire_rl" style="@style/DataValue" />
                    </TableRow>

                    <TableRow style="@style/DataRow">
                        <TextView style="@style/DataLabel" android:text="@string/vehicle_tire_rr" />
                        <TextView android:id="@+id/vehicle_tire_rr" style="@style/DataValue" />
                    </TableRow>

                </TableLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
